# Kopieren nach .env und ausfüllen. .env NIE committen (steht in .gitignore).

# LiteLLM-Proxy der FHNW (URL und Key aus dem LiteLLM-Login, SW4)
LLM_BASE_URL=https://<litellm-url-der-fhnw>/v1
LLM_API_KEY=sk-...
LLM_MODEL=<modellname-aus-python-llm.py>

# Alternative: Apertus über die Swiss AI Plattform (eigener Key, nur EIN Block aktiv lassen)
# LLM_BASE_URL=https://api.swissai.svc.cscs.ch/v1
# LLM_API_KEY=sk-rc-...
# LLM_MODEL=CSCS-Inference/swiss-ai/Apertus-v1.5-70B
# LLM_TEMPERATURE=0
# Verbindung testen: python skripte/test_apertus.py

# Falls ein Modell kein Function Calling kann: json_schema ausprobieren
STRUCTURED_METHOD=function_calling

# Tracing mit LangSmith (smith.langchain.com, Free Tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=qq_govdox
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Kalender (nodes/kalender.py): "google" = über den Kalender-MCP in den Google Kalender,
# sonst .ics-Datei in ausgabe/. Für Testläufe über alle Briefe auf ics lassen.
KALENDER_KANAL=ics
GOOGLE_CALENDAR_ID=<kalender-id, z. B. konto@... oder ...@group.calendar.google.com>
